# ==========================================
# Expense Management - Backend Environment Variables
# ==========================================

# Port on which the Express server will listen (Render assigns PORT automatically)
PORT=5000

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/ExpenseManagementDB?retryWrites=true&w=majority

# Node Environment (development | production)
NODE_ENV=production
